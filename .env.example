# Server Configuration
# APP_ENV=production enables strict startup checks (see DEPLOYMENT.md).
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# CORS: comma-separated allowed origins. Development default is "*".
# Production REQUIRES an explicit list and rejects "*".
# https://primecoreinfo.com is always allowed in production.
CORS_ORIGINS=*

# Serve the static website from this process (development only; defaults to false in production)
SERVE_STATIC=true

# Number of trusted reverse proxies in front of the app. 0 = ignore X-Forwarded-For.
TRUSTED_PROXY_COUNT=0

# Database Configuration
# Production: absolute path on a PERSISTENT disk, e.g. /var/data/enquiries.db
DATABASE_PATH=enquiries.db

# Email / SMTP Notification Settings
NOTIFICATION_EMAIL=connect@primecoreinfo.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Security & Spam Protection
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600
